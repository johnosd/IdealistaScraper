{
  "manifest_version": 3,
  "name": "Extrator Idealista (Links e Itens)",
  "version": "1.5.0",
  "minimum_chrome_version": "141",
  "description": "Extrai links e itens (com paginação) e exporta JSON, com suporte a proxy.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "proxy",
    "webRequest",
    "webRequestAuthProvider",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.idealista.pt/*",
    "https://api.ipify.org/*"
  ],
  "background": {
    "service_worker": "dist/background.bundle.js"
  },
  "action": {
    "default_title": "Extratores"
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": ["https://*.idealista.pt/*"],
      "js": ["dist/linkExtractor.bundle.js", "dist/content.bundle.js"],
      "run_at": "document_idle"
    }
  ]
}
